{
"name":"Carne Instabile",
"desc":"Whenever Giordano loses 10 hit points, a small mimutato creature tears itself from the flesh and joins the battle."
},

{
"name":"Tormented Soul",
"desc":"Healing magic damages Giordano instead. The damage dealt by healing spells is doubled."
}

],

"actions":[

{
"name":"Morte Tentacolare",
"desc":"_Melee Weapon Attack:_ [STR ATK] to hit, reach 3m. _Hit:_ [1D10] piercing damage."
},

{
"name":"Dardi Putridi",
"desc":"Giordano launches pieces of his own flesh. _Ranged Attack:_ [STR ATK] to hit, range 12m, two targets. _Hit:_ [3D4] piercing damage + [1D4] poison damage at the start of the target's next turn."
},

{
"name":"Colonne Schiaccianti",
"desc":"Stone columns slam down violently. Each creature within 3m must make a Dexterity saving throw (DC [DEX SAVE]). On a failure they take [3D4] bludgeoning damage."
},

{
"name":"Tentacolo Afferrante",
"desc":"_Melee Attack:_ [STR ATK] to hit. _Hit:_ [1D8] piercing damage and the target must succeed on a Strength saving throw (DC [STR SAVE]) or become restrained."
}

],

"bonusActions":[

{
"name":"Rigurgito di Carne",
"desc":"Giordano spits flesh onto the ground. The area becomes difficult terrain until the end of the next round."
}

],

"reactions":[

{
"name":"Tentacolo Difensivo",
"desc":"When a creature enters within 3m. _Melee Attack:_ [STR ATK] to hit. _Hit:_ [1D6] piercing damage."
}

],

